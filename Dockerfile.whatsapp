# syntax=docker/dockerfile:1
#
# Worker de WhatsApp (Baileys). Imagen aparte de la app web: Baileys y sus
# dependencias (libsignal, el puente WebAssembly) nunca entran a la imagen
# de Next.js. Ver docs/whatsapp.md.

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV SENTRYCLI_SKIP_DOWNLOAD=1
# Misma zona horaria que la app: horario 9–22 y "hoy" de los recordatorios.
ENV TZ=America/Mexico_City

# Dependencias de la app (Prisma Client, date-fns… que usa src/lib) + tsx.
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate

# Dependencias propias del worker.
# patches/: el postinstall de npm ci parchea Baileys; si el parche no aplica, el build falla.
COPY worker/whatsapp/package.json worker/whatsapp/package-lock.json ./worker/whatsapp/
COPY worker/whatsapp/patches ./worker/whatsapp/patches
RUN cd worker/whatsapp && npm ci

COPY tsconfig.json ./
COPY src ./src
COPY worker/whatsapp ./worker/whatsapp

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker
USER worker

CMD ["node_modules/.bin/tsx", "--tsconfig", "worker/whatsapp/tsconfig.json", "worker/whatsapp/index.ts"]
