// ContratasApp — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Rol {
  ADMIN
  VIEWER
}

model User {
  id             String             @id @default(cuid())
  nombre         String?
  email          String             @unique
  passwordHash   String?
  rol            Rol                @default(VIEWER)
  image          String?
  emailVerified  DateTime?
  accounts       Account[]
  sessions       Session[]
  clientes       Cliente[]
  contratas      Contrata[]
  deudores       Deudor[]
  configuracion  Configuracion?
  suscripciones  PushSubscription[]
  cortesCaja     CorteCaja[]
  citasAgendadas CitaAgendada[]
  creadoEn       DateTime           @default(now())

  /// Acceso al monitor de operaciones (/monitor): ve datos de TODOS los
  /// espacios, así que no depende del rol sino de este permiso explícito.
  /// Se otorga con `npx tsx scripts/acceso-monitor.ts <correo>`.
  accesoMonitor  Boolean            @default(false)

  // Espacio de trabajo: null = dueño de su propio espacio (registro público);
  // con valor = miembro invitado del espacio de ese dueño (creado desde
  // Configuración → Usuarios). Todos los datos del miembro se scopean al
  // ownerId del dueño, no al suyo.
  workspaceOwner   User?   @relation("EspacioMiembros", fields: [workspaceOwnerId], references: [id], onDelete: Cascade)
  workspaceOwnerId String?
  miembros         User[]  @relation("EspacioMiembros")

  @@index([workspaceOwnerId])
}

model PushSubscription {
  id       String   @id @default(cuid())
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  endpoint String   @unique
  p256dh   String
  auth     String
  creadoEn DateTime @default(now())

  @@index([ownerId])
}

// NextAuth adapter models (Google OAuth + sessions)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Dominio: Contratas
// ---------------------------------------------------------------------------

enum TipoContrata {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum ModoQuincenal {
  QUINCE_DIAS
  DIAS_15_Y_ULTIMO
  DIAS_1_Y_15
}

model Cliente {
  id         String         @id @default(cuid())
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  nombre     String
  telefono   String?
  direccion  String?
  referencia String?
  notas      String?
  contratas  Contrata[]
  citas      CitaAgendada[]
  creadoEn   DateTime       @default(now())

  @@index([ownerId])
}

model Contrata {
  id               String         @id @default(cuid())
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  cliente          Cliente        @relation(fields: [clienteId], references: [id])
  clienteId        String
  tipo             TipoContrata
  monto            Float
  abono            Float
  fechaInicio      DateTime
  numCuotas        Int            @default(10)
  mes              String
  notas            String?
  pagos            Pago[]
  /// Se marcó el saldo pendiente como deuda (proceso manual, ver Deudor).
  convertidaADeuda Boolean        @default(false)
  deudor           Deudor?        @relation(fields: [deudorId], references: [id], onDelete: SetNull)
  deudorId         String?
  citasComoOrigen  CitaAgendada[] @relation("CitaContrataOrigen")
  citaQueLaCreo    CitaAgendada?  @relation("CitaContrataCreada")
  creadoEn         DateTime       @default(now())

  @@index([clienteId])
  @@index([ownerId])
  @@index([deudorId])
}

model Pago {
  id              String    @id @default(cuid())
  contrata        Contrata  @relation(fields: [contrataId], references: [id], onDelete: Cascade)
  contrataId      String
  numeroCuota     Int
  fechaProgramada DateTime
  fechaPago       DateTime?
  pagado          Boolean   @default(false)
  montoAbonado    Float     @default(0)

  @@index([contrataId])
}

enum TipoCitaContrata {
  NUEVA
  RENOVACION
  /// Se agenda para juntar 2+ contratas activas del cliente en una sola al
  /// entregarse (ver `contratasUnificarIds` abajo) — el mismo movimiento
  /// que "Unificar" desde el perfil del cliente, solo que agendado.
  UNIFICACION
  SIN_DEFINIR
}

enum EstadoCita {
  PENDIENTE
  ENTREGADA
  CANCELADA
}

/// Contrata futura anotada de antemano ("Fulanito quiere 2 mil para el
/// 15"), sin comprometerse todavía: monto y fecha son estimados, pueden
/// cambiar o no concretarse. `fechaEntrega` es el día en que se entregaría
/// el dinero — no el del primer pago (ese se calcula como siempre a partir
/// de la fecha real de entrega, el día que se confirma). No afecta saldo,
/// cartera ni estadísticas hasta que se convierte en una Contrata real.
model CitaAgendada {
  id               String           @id @default(cuid())
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  cliente          Cliente          @relation(fields: [clienteId], references: [id])
  clienteId        String
  /// Si ya se sabe qué contrata se va a renovar. Opcional: puede decidirse
  /// después, antes de convertir la cita en contrata real.
  contrataOrigen   Contrata?        @relation("CitaContrataOrigen", fields: [contrataOrigenId], references: [id], onDelete: SetNull)
  contrataOrigenId String?
  /// Solo con tipo UNIFICACION: qué contratas activas del cliente se
  /// planea juntar al entregar. No es una relación formal (a propósito,
  /// igual que `contrataOrigenId` es opcional) — al convertir la cita se
  /// vuelven a validar en vivo contra la base, así que una contrata que
  /// mientras tanto se liquidó o se le agregó otra cuota simplemente ya no
  /// aparece marcable, sin que la cita quede en un estado inconsistente.
  contratasUnificarIds String[]      @default([])
  /// La contrata real generada al confirmar esta cita (si se llegó a dar).
  contrataCreada   Contrata?        @relation("CitaContrataCreada", fields: [contrataCreadaId], references: [id], onDelete: SetNull)
  contrataCreadaId String?          @unique
  tipo             TipoCitaContrata @default(SIN_DEFINIR)
  /// Cada cuánto va a pagar la contrata que salga de esta cita. Opcional
  /// porque puede no saberse al agendar (y las citas anteriores a este
  /// campo se quedan en null): la periodicidad real se fija al crear la
  /// contrata. Sirve para agrupar la lista de "por entregar".
  periodicidad     TipoContrata?
  montoEstimado    Float
  fechaEntrega     DateTime
  notas            String?
  estado           EstadoCita       @default(PENDIENTE)
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  @@index([ownerId, estado, fechaEntrega])
  @@index([clienteId])
}

// ---------------------------------------------------------------------------
// Dominio: Deudores
// ---------------------------------------------------------------------------

model Deudor {
  id           String        @id @default(cuid())
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  nombre       String
  /// Para mandarle recordatorios de abono por WhatsApp. Opcional.
  telefono     String?
  deudaInicial Float         @default(0)
  notas        String?
  abonos       AbonoDeudor[]
  contratas    Contrata[]
  creadoEn     DateTime      @default(now())

  @@index([ownerId])
}

model AbonoDeudor {
  id       String   @id @default(cuid())
  deudor   Deudor   @relation(fields: [deudorId], references: [id], onDelete: Cascade)
  deudorId String
  fecha    DateTime
  monto    Float
  restante Float
  notas    String?

  @@index([deudorId])
}

// ---------------------------------------------------------------------------
// Configuración
// ---------------------------------------------------------------------------

model Configuracion {
  id                  String        @id @default(cuid())
  owner               User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId             String        @unique
  nombreApp           String        @default("Kredired")
  tasaSemanal         Float         @default(125)
  tasaQuincenal       Float         @default(135)
  tasaMensual         Float         @default(200)
  cuotasPorDefecto    Int           @default(10)
  maxCuotas           Int           @default(52)
  modoFechasQuincenal ModoQuincenal @default(QUINCE_DIAS)
  diaCobroSemanal     Int           @default(1)
  colorPrimario       String        @default("#0F7BFF")
  logoUrl             String?
}

// ---------------------------------------------------------------------------
// Estado de resultados: corte de caja mensual
// ---------------------------------------------------------------------------

/// Cierre mensual congelado (contratas dadas vs cobrado ese mes). Se genera
/// solo — vía cron del VPS el último día del mes — o manualmente desde la
/// UI; una vez creado no se recalcula automáticamente, para que el reporte
/// histórico no cambie por correcciones posteriores a los datos.
model CorteCaja {
  id                  String   @id @default(cuid())
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId             String
  anio                Int
  mes                 Int
  contratasDadas      Float
  numContratasDadas   Int
  cobrado             Float
  gananciaInteres     Float
  saldoPendienteFin   Float
  contratasActivasFin Int
  generadoEn          DateTime @default(now())

  @@unique([ownerId, anio, mes])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Offline: idempotencia de escrituras encoladas
// ---------------------------------------------------------------------------

/// Registra una idempotency key ya procesada para que un reintento de la cola
/// de escritura offline (misma key) no vuelva a aplicar la mutación.
model ProcessedOperation {
  /// Idempotency key generada por el cliente (uuid).
  id        String   @id
  ownerId   String
  endpoint  String
  /// Null mientras la operación está reservada pero todavía ejecutándose.
  resultado Json?
  /// false = reservada y en curso; true = terminada y `resultado` es válido.
  /// Ver `withIdempotency`: la fila se inserta ANTES de ejecutar la mutación
  /// para que dos peticiones con la misma key no puedan ejecutarla las dos.
  completada Boolean @default(false)
  creadoEn  DateTime @default(now())

  @@index([ownerId])
  @@index([creadoEn])
}

// ---------------------------------------------------------------------------
// Seguridad: rate limiting de login y bitácora de auditoría
// ---------------------------------------------------------------------------

/// Cada intento de inicio de sesión (exitoso o fallido), para frenar ataques
/// de fuerza bruta. No se scopea por espacio: un intento fallido puede no
/// corresponder a ningún usuario. Se puede purgar periódicamente.
model LoginAttempt {
  id       String   @id @default(cuid())
  email    String
  ip       String
  exitoso  Boolean
  creadoEn DateTime @default(now())

  @@index([email, creadoEn])
  @@index([ip, creadoEn])
}

/// Bitácora de acciones sensibles dentro de un espacio de trabajo (eliminar,
/// marcar deuda, cambios de usuario, etc.). Guarda quién, qué y cuándo.
model AuditLog {
  id          String   @id @default(cuid())
  ownerId     String
  actorId     String
  actorNombre String?
  accion      String
  entidad     String?
  entidadId   String?
  detalle     Json?
  ip          String?
  creadoEn    DateTime @default(now())

  @@index([ownerId, creadoEn])
}

/// Errores/crashes reportados desde el cliente (JS no capturado, cola
/// offline atorada) o desde rutas /api/* del servidor. Complementa a Sentry
/// con una copia propia consultable directo en la BD (p. ej. por psql o
/// Prisma Studio) sin depender de una cuenta/dashboard externo. ownerId y
/// actorId son opcionales: un crash puede ocurrir antes de autenticarse
/// (p. ej. en /login).
model ErrorLog {
  id        String   @id @default(cuid())
  origen    String
  ownerId   String?
  actorId   String?
  mensaje   String
  stack     String?
  url       String?
  userAgent String?
  contexto  Json?
  creadoEn  DateTime @default(now())

  @@index([ownerId, creadoEn])
  @@index([creadoEn])
}
