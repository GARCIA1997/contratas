# --- Base de datos (PostgreSQL) ---
# Local (Homebrew):        postgresql://devuser:devpass123@localhost:5432/contratas
# VPS con docker-compose:  se arma solo (ver docker-compose.yml), no la pongas aquí a mano.
# VPS con Postgres nativo: postgresql://usuario:password@localhost:5432/contratas?schema=public
DATABASE_URL="postgresql://usuario:password@localhost:5432/contratas?schema=public"

# --- Solo si usas docker-compose.yml (ignoradas en local/PM2) ---
POSTGRES_USER="contratas"
POSTGRES_PASSWORD="cambia-esto"
POSTGRES_DB="contratas"

# --- NextAuth ---
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
# Local: http://localhost:3000 · Prod: https://kredired.cloud (debe coincidir con el dominio real, sin slash final)
NEXTAUTH_URL="https://kredired.cloud"

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# --- Notificaciones push (opcional) ---
# Genera claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu@correo.com"
# Secreto para el cron de recordatorios diarios. En VPS lo usa deploy/crontab.example
# vía "Authorization: Bearer <CRON_SECRET>"; en Vercel lo manda el cron nativo.
CRON_SECRET=""

# --- Seed del admin inicial (login por teléfono) ---
ADMIN_EMAIL="3131128425"
ADMIN_PASSWORD="cambia-esto"
ADMIN_NOMBRE="Administrador"

# --- Monitoreo de errores (Sentry, opcional) ---
# Crea un proyecto Next.js en sentry.io y copia el DSN (mismo valor en ambas).
# Sin estas variables, Sentry queda desactivado (no rompe nada, solo no reporta).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Solo necesarios para subir sourcemaps al buildear (stack traces legibles en Sentry).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# WhatsApp automático (solo el worker, docs/whatsapp.md). Cifra la sesión de
# WhatsApp guardada en la BD: openssl rand -base64 32. Si se pierde o cambia,
# hay que volver a vincular todos los números.
WHATSAPP_SESSION_KEY=""
